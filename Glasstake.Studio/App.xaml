<Application x:Class="Glasstake.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!--The agent's color: everything the agent proposes carries it.-->
            <LinearGradientBrush x:Key="Agent.Gradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF8B5CF6" Offset="0"/>
                <GradientStop Color="#FF3B82F6" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Agent.Brush" Color="#FF8B5CF6"/>

            <!--Kinds of change, the same on the timeline and in the legend.-->
            <SolidColorBrush x:Key="Change.Cut" Color="#FFE5484D"/>
            <SolidColorBrush x:Key="Change.Faster" Color="#FFF5A524"/>
            <SolidColorBrush x:Key="Change.Caption" Color="#FF3B82F6"/>
            <SolidColorBrush x:Key="Change.Highlight" Color="#FFE879F9"/>
            <SolidColorBrush x:Key="Change.Redaction" Color="#FF71717A"/>

            <!--Steps of a filmed shot list on the editor's step track.-->
            <SolidColorBrush x:Key="Step.Brush" Color="#FF14B8A6"/>

            <Style x:Key="Keycap" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="1,1,1,2"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="5,0"/>
                <Setter Property="MinWidth" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="TextElement.FontSize" Value="11"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Style>

            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
