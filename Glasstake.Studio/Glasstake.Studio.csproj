<Project Sdk="Microsoft.NET.Sdk">
  <!-- Glasstake Studio: the new desktop UI (record, review-before-apply). New Glasstake code, not derived from ScreenToGif. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>True</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!--The UI texts: English in Localization\Strings.resx, German in Strings.de.resx. The typed accessor (Strings) is
      generated before the XAML is compiled, so markup can use {x:Static l:Strings.Key} and a missing key fails the build.-->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" Visible="false" />
  </ItemGroup>
  <Target Name="GenerateStrings" BeforeTargets="MarkupCompilePass1;CoreCompile" Inputs="Localization\Strings.resx" Outputs="$(IntermediateOutputPath)Strings.Designer.cs">
    <GenerateResource Sources="Localization\Strings.resx" OutputResources="$(IntermediateOutputPath)Strings.typed.resources" ExecuteAsTool="false"
                      StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Glasstake.Studio.Localization" StronglyTypedClassName="Strings"
                      StronglyTypedManifestPrefix="Glasstake.Studio.Localization" StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs" PublicClass="true" />
  </Target>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Glasstake.Capture\Glasstake.Capture.csproj" />
    <ProjectReference Include="..\Glasstake.Core\Glasstake.Core.csproj" />
    <ProjectReference Include="..\Glasstake.Editing\Glasstake.Editing.csproj" />
    <ProjectReference Include="..\Glasstake.Export\Glasstake.Export.csproj" />
  </ItemGroup>
</Project>
