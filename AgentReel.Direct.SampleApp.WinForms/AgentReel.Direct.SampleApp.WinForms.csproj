<Project Sdk="Microsoft.NET.Sdk">
  <!-- The "Invoices" sample as a WinForms app, to check shot lists against WinForms' UI Automation providers. The v2
       switch is the next release: a moved button, a renamed label, a removed control and an icon button whose id and
       name both changed (only its picture stays). New AgentReel code, not derived from ScreenToGif. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>True</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Platforms>AnyCPU;ARM64;x64;x86</Platforms>
    <Configurations>Debug;Release;Debug (Store)</Configurations>
  </PropertyGroup>
</Project>
