<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows.Graphics.Capture implementation of ICaptureService. New Glasstake code, not derived from ScreenToGif. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>True</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Glasstake.Core\Glasstake.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Glasstake.Capture.Tests" />
  </ItemGroup>
</Project>
