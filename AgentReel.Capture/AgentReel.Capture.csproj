<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows.Graphics.Capture implementation of ICaptureService. New AgentReel code, not derived from ScreenToGif. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>True</UseWPF>
    <Platforms>AnyCPU;ARM64;x64;x86</Platforms>
    <Configurations>Debug;Release;Debug (Store)</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentReel.Core\AgentReel.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentReel.Capture.Tests" />
  </ItemGroup>
</Project>
