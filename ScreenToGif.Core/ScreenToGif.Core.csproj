<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless core: project model, undo stack and (later) export and capture services.
       WPF imaging types are allowed, the Dispatcher, Application.Current and windows are not. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>True</UseWPF>
    <DebugType>embedded</DebugType>
    <Platforms>AnyCPU;ARM64;x64;x86</Platforms>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Configurations>Debug;Release;Debug (Store)</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScreenToGif.Model\ScreenToGif.Domain.csproj" />
    <ProjectReference Include="..\ScreenToGif.Util\ScreenToGif.Util.csproj" />
    <ProjectReference Include="..\ScreenToGif.ViewModel\ScreenToGif.ViewModel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KGySoft.Drawing" />
    <PackageReference Include="KGySoft.Drawing.Wpf" />
  </ItemGroup>
</Project>
