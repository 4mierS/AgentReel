<Project Sdk="Microsoft.NET.Sdk">
  <!-- AgentReel's own export: GIF and APNG encoders and MP4 through Windows Media Foundation. New AgentReel code,
       written from the format specifications, not derived from ScreenToGif. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>True</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;ARM64;x64;x86</Platforms>
    <Configurations>Debug;Release;Debug (Store)</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.MediaFoundation" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentReel.Export.Tests" />
  </ItemGroup>
</Project>
