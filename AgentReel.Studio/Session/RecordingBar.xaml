<Window x:Class="AgentReel.Studio.Session.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Recording · AgentReel Studio" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI Variable Text">

    <!--Left out of every capture (see Native.ExcludeFromCapture), so it may sit on top of what is recorded.-->
    <!--Border does not clip its content, so the buttons are round too and keep the same 6 px to the edge: concentric with the pill.-->
    <Border Margin="12" Padding="18,6,6,6" CornerRadius="25" Background="#F01C1C22" BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Bar_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FFE5484D" VerticalAlignment="Center">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <TextBlock x:Name="TimeText" Text="0:00" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="White"
                       VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="44"/>

            <StackPanel VerticalAlignment="Center" Margin="10,0,16,0" MaxWidth="240">
                <TextBlock x:Name="TargetText" FontSize="12" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FramesText" Text="starting…" FontSize="11" Foreground="#99FFFFFF"/>
            </StackPanel>

            <ui:Button x:Name="DiscardButton" Height="36" Width="36" Padding="0" CornerRadius="18" Appearance="Transparent" Click="Discard_Click" ToolTip="Stop and throw the recording away">
                <ui:SymbolIcon Symbol="Delete20" FontSize="16" Foreground="#CCFFFFFF"/>
            </ui:Button>

            <ui:Button x:Name="StopButton" Height="36" Margin="4,0,0,0" Padding="14,0,10,0" CornerRadius="18" Appearance="Danger" Click="Stop_Click" ToolTip="Stop recording (F8)">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Stop" Foreground="White" VerticalAlignment="Center"/>
                    <Border x:Name="HotkeyCap" Style="{StaticResource Keycap}" Margin="10,0,0,0" CornerRadius="9" Background="#33FFFFFF" BorderBrush="#55FFFFFF">
                        <TextBlock Text="F8" Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Border>
</Window>
