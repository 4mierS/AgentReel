<Project Sdk="Microsoft.NET.Sdk">
  <!-- AgentReel Studio: the new desktop UI (record, review-before-apply). New AgentReel code, not derived from ScreenToGif. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>True</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;ARM64;x64;x86</Platforms>
    <Configurations>Debug;Release;Debug (Store)</Configurations>
  </PropertyGroup>
  <!--The UI texts: English in Localization\Strings.resx, German in Strings.de.resx. The typed accessor (Strings) is
      generated before the XAML is compiled, so markup can use {x:Static l:Strings.Key} and a missing key fails the build.-->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" Visible="false" />
  </ItemGroup>
  <Target Name="GenerateStrings" BeforeTargets="MarkupCompilePass1;CoreCompile" Inputs="Localization\Strings.resx" Outputs="$(IntermediateOutputPath)Strings.Designer.cs">
    <GenerateResource Sources="Localization\Strings.resx" OutputResources="$(IntermediateOutputPath)Strings.typed.resources" ExecuteAsTool="false"
                      StronglyTypedLanguage="CSharp" StronglyTypedNamespace="AgentReel.Studio.Localization" StronglyTypedClassName="Strings"
                      StronglyTypedManifestPrefix="AgentReel.Studio.Localization" StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs" PublicClass="true" />
  </Target>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentReel.Capture\AgentReel.Capture.csproj" />
    <ProjectReference Include="..\AgentReel.Core\AgentReel.Core.csproj" />
    <ProjectReference Include="..\AgentReel.Editing\AgentReel.Editing.csproj" />
    <ProjectReference Include="..\AgentReel.Export\AgentReel.Export.csproj" />
  </ItemGroup>
</Project>
