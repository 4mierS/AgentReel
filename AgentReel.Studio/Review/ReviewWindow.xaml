<ui:FluentWindow x:Class="AgentReel.Studio.Review.ReviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:review="clr-namespace:AgentReel.Studio.Review"
                 Title="Review · AgentReel Studio" Width="1280" Height="880" MinWidth="880" MinHeight="620"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 FontFamily="Segoe UI Variable Text">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Review · AgentReel Studio" ShowMaximize="True"/>

        <!--What the agent proposes: the main thing to read, so it comes first and in large type.-->
        <Grid Grid.Row="1" Margin="28,4,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{StaticResource Agent.Gradient}" VerticalAlignment="Top" Margin="0,2,16,0">
                <ui:SymbolIcon Symbol="Sparkle24" Filled="True" FontSize="22" Foreground="White"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="AgentText" Text="YOUR AGENT SUGGESTS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Agent.Brush}" Margin="0,0,0,2"/>
                <TextBlock x:Name="DescriptionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" MaxWidth="900" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="24,0,0,0">
                <TextBlock x:Name="DurationText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="DurationDetailText" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <!--The stage: one large picture. Holding O shows the original at the same moment, so every change stands out.-->
        <Border Grid.Row="2" Margin="28,0" CornerRadius="10" Background="#FF0B0B0E" ClipToBounds="True">
            <Grid>
                <Image x:Name="StageImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0"/>

                <Border x:Name="StageBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="10,4" CornerRadius="999"
                        Background="{StaticResource Agent.Gradient}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="StageBadgeIcon" Symbol="Sparkle16" Filled="True" FontSize="13" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StageBadgeText" Text="Edit" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Padding="10,5" CornerRadius="999" Background="#99000000">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hold" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Keycap}" Background="#33FFFFFF" BorderBrush="#55FFFFFF" Margin="5,0">
                            <TextBlock Text="O" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="to compare with the original" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--Transport and the two timelines.-->
        <Grid Grid.Row="3" Margin="28,14,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <ui:Button x:Name="PlayButton" Appearance="Secondary" Width="40" Height="36" Padding="0" Click="PlayButton_Click" ToolTip="Play / pause (Space)">
                    <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" Filled="True" FontSize="18"/>
                </ui:Button>
                <TextBlock x:Name="TimeText" FontSize="14" FontFamily="Segoe UI Variable Display" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!--Legend: only the kinds this edit has.-->
            <WrapPanel x:Name="LegendPanel" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Transparent" Padding="8,4" Click="PreviousChange_Click" ToolTip="Previous change (Shift+←)">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16"/>
                </ui:Button>
                <TextBlock x:Name="ChangeText" FontSize="12" MinWidth="110" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:Button Appearance="Transparent" Padding="8,4" Click="NextChange_Click" ToolTip="Next change (Shift+→)">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16"/>
                </ui:Button>
            </StackPanel>

            <review:ChangeTimeline x:Name="Timeline" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"/>

            <!--The changes as text, so the user can read them instead of decoding the timeline.-->
            <ItemsControl x:Name="ChangeList" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="76,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <!--The decision. Feedback is a sentence to the agent, not a form.-->
        <Border Grid.Row="4" Margin="0,16,0,0" Padding="28,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="DecisionGrid" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="FeedbackBox" Grid.Column="0"
                                Icon="{ui:SymbolIcon Sparkle20}" MinHeight="40" VerticalContentAlignment="Center" AcceptsReturn="False"
                                TextChanged="FeedbackBox_TextChanged" KeyDown="FeedbackBox_KeyDown"/>

                    <ui:Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0" Height="40" Appearance="Secondary" IsEnabled="False" Click="Send_Click"
                               ToolTip="Send feedback (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Send24" FontSize="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Send"/>
                        </StackPanel>
                    </ui:Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="24,0,0,0">
                        <!--Discard deletes the edit; keeping its files is the rare case, so it sits behind the arrow.-->
                        <ui:Button x:Name="DiscardButton" Height="40" Appearance="Secondary" Click="Discard_Click" ToolTip="Reject and delete the edit (Esc)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Discard" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Keycap}" Margin="8,0,0,0">
                                    <TextBlock Text="Esc" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="DiscardMoreButton" Height="40" Width="32" Padding="0" Margin="2,0,0,0" Appearance="Secondary" Click="DiscardMore_Click"
                                   ToolTip="More ways to discard">
                            <ui:SymbolIcon Symbol="ChevronDown20" FontSize="14"/>
                            <ui:Button.ContextMenu>
                                <ContextMenu Placement="Top">
                                    <MenuItem Header="Discard and delete the edit" InputGestureText="Esc" Click="Discard_Click"/>
                                    <MenuItem Header="Discard, but keep its files" InputGestureText="Shift+Esc" Click="DiscardKeep_Click"/>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                        <ui:Button x:Name="KeepButton" Height="40" Margin="8,0,0,0" Appearance="Primary" Click="Keep_Click" ToolTip="Keep the edit (Ctrl+Enter)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Keep edit" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Keycap}" Margin="8,0,0,0" Background="#33FFFFFF" BorderBrush="#55FFFFFF">
                                    <TextBlock Text="Ctrl ⏎" Foreground="White" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!--After the decision: what happened and what comes next.-->
                <StackPanel x:Name="DonePanel" Grid.ColumnSpan="3" Orientation="Horizontal" Visibility="Collapsed" Height="40">
                    <ui:SymbolIcon x:Name="DoneIcon" Symbol="CheckmarkCircle24" Filled="True" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="DoneText" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
